# Application
KOCASE_DB_PATH=/tmp/kocaseimport/jobs.sqlite3
KOCASE_WORK_DIR=/tmp/kocaseimport/work
KOCASE_SECRET_KEY=
KOCASE_LIVE_EDITS=false
KOCASE_USER_AGENT=KoCaseImport/0.2.0 (https://ko.wikisource.org/; contact=your-wikimedia-username)

# Constitutional Court public-data API (optional but recommended)
# Apply at https://www.data.go.kr/data/15141079/openapi.do
CCOURT_SERVICE_KEY=
CCOURT_OPENAPI_URL=
CCOURT_CASE_PARAM=eventNo
# If the decision is HWP-only, use the official case collection/gazette PDF.
# Its edition is recorded in the filename, log, manifest and Commons description.
CCOURT_ALLOW_PUBLISHED_PDF=true

# Required web OAuth2: confidential multi-user Wikimedia application.
MW_OAUTH_CLIENT_ID=
MW_OAUTH_CLIENT_SECRET=
MW_OAUTH_REDIRECT_URI=https://YOUR_TOOL.toolforge.org/oauth/callback
# Fernet key: base64.urlsafe_b64encode(secrets.token_bytes(32)).decode()
KOCASE_TOKEN_KEY=

# Optional operator CLI credentials. Not used by web jobs.
# Example username: ExampleBot@KoCaseImport
MW_BOT_USERNAME=
MW_BOT_PASSWORD=
# Or an OAuth2 bearer token instead of BotPassword:
MW_BEARER_TOKEN=

# Targets
COMMONS_API=https://commons.wikimedia.org/w/api.php
WIKISOURCE_API=https://ko.wikisource.org/w/api.php
WIKISOURCE_MAIN_NAMESPACE_PREFIX=

# OCR
OCR_ENGINE=tesseract
OCR_LANG=kor
OCR_PSM=3
OCR_MIN_TEXT_CHARS=80
OCR_TIMEOUT=120

# Import behavior
KOCASE_OVERWRITE=false
KOCASE_EDIT_DELAY=0.6
KOCASE_COMMONS_CATEGORY=
